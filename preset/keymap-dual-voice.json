      "modifierFlagsRawValue": 1048576,
      "keyCode": 40,
      "keyLabel": "K"
    },
    "menu": {
      "modifierFlagsRawValue": 0,
      "keyCode": 48,
      "keyLabel": "Tab"
    }
  },
  "secondaryButtonBindings": {
    "power": {
      "doubleClick": {
        "action": "playPause"
      },
      "longPress": {
        "action": "customShortcut",
        "shortcut": {
          "modifierFlagsRawValue": 131072,
          "keyCode": 48,
          "keyLabel": "Tab"
        }
      }
    },
    "up": {
      "longPress": {
        "action": "disabled"
      }
    },
    "down": {
      "longPress": {
        "action": "disabled"
      }
    },
    "left": {
      "doubleClick": {
        "action": "disabled"
      },
      "longPress": {
        "action": "disabled"
      }
    },
    "right": {
      "doubleClick": {
        "action": "disabled"
      },
      "longPress": {
        "action": "disabled"
      }
    },
    "ok": {
      "doubleClick": {
        "action": "commandSelectAll"
      },
      "longPress": {
        "action": "commandReturn"
      }
    },
    "back": {
      "doubleClick": {
        "action": "disabled"
      },
      "longPress": {
        "action": "customShortcut",
        "shortcut": {
          "modifierFlagsRawValue": 524288,
          "keyCode": 51,
          "keyLabel": "⌫"
        }
      }
    },
    "home": {
      "doubleClick": {
