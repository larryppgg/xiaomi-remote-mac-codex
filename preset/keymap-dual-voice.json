{
  "format": 1,
  "testedWith": "SayAll 1.9.21 / Xiaomi Bluetooth Remote 2 Pro (RC003)",
  "buttonBindings": {
    "power": "escape",
    "up": "arrowUp",
    "down": "arrowDown",
    "left": "arrowLeft",
    "right": "arrowRight",
    "ok": "returnKey",
    "back": "deleteBackward",
    "home": "customShortcut",
    "menu": "customShortcut",
    "volume_up": "scrollUp",
    "volume_down": "scrollDown",
    "tv": "appSwitcher"
  },
  "buttonShortcuts": {
