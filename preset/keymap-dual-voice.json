        "action": "customShortcut",
        "shortcut": {
          "modifierFlagsRawValue": 262144,
          "keyCode": 48,
          "keyLabel": "Tab"
        }
      }
    },
    "tv": {
      "doubleClick": {
        "action": "customShortcut",
